# FirstMinute environment configuration.
# Copy to `.env`, fill in provider credentials if needed, and pass it to Docker
# with `docker run --env-file .env`. Node does not automatically load `.env`.

# Server
PORT=8787
HOST=0.0.0.0

# JSON database location (stores incidents + reminders)
DB_DIR=./server/data

# Logging
LOG_LEVEL=info
# LOG_FILE=/var/log/firstminute.log

# Doctor classification is optional; deterministic Doc. Jr retrieval works offline.
FIRSTMINUTE_DOCJR_USE_LLM=true
# Draft protocols are blocked in production unless explicitly enabled after review.
# FIRSTMINUTE_ALLOW_DRAFT_PROTOCOLS=true

# AI provider (required for image analysis and uncached videos)
# The app writes these values to a private config file in the user's home directory
# when no .z-ai-config file exists there or in the project root.
# ZAI_BASE_URL=https://YOUR_PROVIDER_API/v1
# ZAI_API_KEY=YOUR_API_KEY
